# Nunca exponha esta chave em VITE_* ou no bundle do navegador.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Provedor do copiloto visual: openai ou deepseek.
PLAN_AI_PROVIDER=openai

# Alias solicitado para o copiloto visual Plan-to-BIM.
# Para produção reproduzível, pode ser trocado pelo snapshot aprovado em evals.
OPENAI_PLAN_MODEL=gpt-6-astra
# Direct visual recognition: seven views in one request. Independent of editor review effort.
OPENAI_PLAN_VISUAL_REASONING_EFFORT=high
OPENAI_PLAN_MAX_OUTPUT_TOKENS=48000
# Project defaults, explicitly marked as assumptions, not recognized dimensions.
PLAN_BIM_WALL_HEIGHT_M=2.8
PLAN_BIM_DOOR_HEIGHT_M=2.1
PLAN_BIM_WINDOW_HEIGHT_M=1.2
PLAN_BIM_WINDOW_SILL_M=1.0
ASTRA_LOCAL_FLOW_ENABLED=false
ASTRA_LOCAL_MAX_WORKERS=2
ASTRA_TEST_USD_BRL=5.50
ASTRA_TEST_RETRY_RESERVE=1.50
ASTRA_TEST_FIXED_COST_BRL=2.50
ASTRA_TEST_PRICE_MULTIPLIER=3.0
ASTRA_TEST_MIN_PRICE_BRL=49.90
# Fixed price for the first page processed by each Conversão Pro order.
PLAN_BIM_MIN_PRICE_BRL=59.90
PLAN_BIM_PRICE_PER_M2=0.50
PLAN_BIM_LOCAL_AREA_ESTIMATION_ENABLED=true
PLAN_BIM_PREANALYSIS_TIMEOUT_SECONDS=240

# Pedido assistido: R$ 0,50/m² declarado no envio. A planta é enviada à equipe
# somente depois do pagamento aprovado. Para Gmail, crie uma senha de app.
PLAN_BIM_ASSISTED_ORDER_ENABLED=true
PLAN_BIM_ASSISTED_RECIPIENT=agenciaduobrotherdigital@gmail.com
PLAN_BIM_ASSISTED_SMTP_HOST=smtp.gmail.com
PLAN_BIM_ASSISTED_SMTP_PORT=587
PLAN_BIM_ASSISTED_SMTP_USERNAME=
PLAN_BIM_ASSISTED_SMTP_PASSWORD=
PLAN_BIM_ASSISTED_FROM=
PLAN_BIM_ASSISTED_SMTP_SSL=false
# Apenas desenvolvimento: grava delivery-preview.eml localmente, nunca envia e-mail.
PLAN_BIM_ASSISTED_EMAIL_DRY_RUN=false

# Checkout Pro. O Access Token e a chave do webhook existem somente no backend.
MERCADOPAGO_CHECKOUT_ENABLED=false
# Mantém a sinalização de pagamento de teste no Plan2BIM. O Checkout Pro usa
# init_point também nos testes; a credencial de teste é que impede cobrança real.
MERCADOPAGO_USE_SANDBOX=true
MERCADOPAGO_ACCESS_TOKEN=
# Fallback apenas para desenvolvimento local. No Cloud Run, use os dois
# segredos específicos abaixo por meio do Secret Manager.
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_SECRET_TEST=
MERCADOPAGO_WEBHOOK_SECRET_PRODUCTION=
# Em produção, use URLs HTTPS públicas. Deixe vazias no teste local.
MERCADOPAGO_PUBLIC_FRONTEND_URL=
MERCADOPAGO_PUBLIC_BACKEND_URL=
MERCADOPAGO_TIMEOUT_SECONDS=15

# DeepSeek usa visão para ler planta/overlay e V4 Pro para auditar o JSON.
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro

# Arquivo privado de amostras autorizadas. A chave secret existe somente no
# backend/Cloud Run; nunca use NEXT_PUBLIC_ ou VITE_ nestas variáveis.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=plan2bim-training
PLAN_BIM_DURABLE_JOBS_ENABLED=false
PLAN_BIM_JOBS_BUCKET=plan2bim-jobs
PLAN_BIM_JOBS_TABLE=plan_bim_jobs
PLAN_BIM_CLOUD_TASKS_PROJECT=
PLAN_BIM_CLOUD_TASKS_LOCATION=us-central1
PLAN_BIM_CLOUD_TASKS_QUEUE=
PLAN_BIM_CLOUD_TASKS_SERVICE_ACCOUNT=
PLAN_BIM_WORKER_BASE_URL=

# Login Google via Supabase Auth. Ative o provider Google no painel do Supabase
# e autorize /auth/callback nas URLs de redirecionamento. A chave secret fica
# somente no backend; o navegador recebe um cookie HTTP-only assinado.
PLAN_BIM_SESSION_SECRET=
PLAN_BIM_SESSION_MAX_AGE_SECONDS=2592000
PLAN_BIM_PUBLIC_FRONTEND_URL=http://127.0.0.1:3001
# Em produção, deixe true para exigir conta em todo pedido pago.
PLAN_BIM_AUTH_REQUIRED=false

# Proteção operacional da beta. O backend guarda apenas HMACs dos IPs.
PLAN_BIM_RATE_LIMIT_SECRET=
PLAN_BIM_UPLOADS_PER_USER_HOUR=8
PLAN_BIM_UPLOADS_PER_IP_HOUR=20
PLAN_BIM_ORDERS_PER_USER_DAY=3
PLAN_BIM_ORDERS_PER_IP_DAY=10
# Plantas, resultados intermediários e modelos ficam disponíveis por 30 dias.
# O pedido e o estado do pagamento permanecem como registro operacional mínimo.
PLAN_BIM_FILE_RETENTION_DAYS=30
